# Template for the dedicated worker host. Do not expose the local Trace UI.
{$TRACE_WORKER_HOST} {
    request_body {
        max_size 8KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @api path /captures /runs/*
    handle @api {
        reverse_proxy 127.0.0.1:3121 {
            transport http {
                response_header_timeout 115s
            }
        }
    }
    handle {
        respond "Not found" 404
    }
    # Access logging is intentionally not enabled: requests contain private tokens.
}
