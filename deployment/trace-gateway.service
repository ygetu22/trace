[Unit]
Description=Trace isolated investigation gateway
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trace
SupplementaryGroups=docker
WorkingDirectory=/opt/trace
EnvironmentFile=/etc/trace/gateway.env
ExecStart=/usr/bin/node /opt/trace/dist/src/gateway.js
Restart=no
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
